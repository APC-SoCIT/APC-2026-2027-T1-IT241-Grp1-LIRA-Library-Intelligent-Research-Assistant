KOHA_BASE_URL=http://YOUR_KOHA_HOST:8081
KOHA_API_USER=YOUR_KOHA_API_USERNAME
KOHA_API_PASSWORD=YOUR_KOHA_API_PASSWORD
PORT=3001
CORS_ORIGINS=http://localhost:5173
KOHA_TIMEOUT_MS=5000
NODE_ENV=development

# Optional: OpenRouter generates embeddings; Supabase holds the pgvector index.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SEMANTIC_INDEX_API_KEY=
SEMANTIC_MATCH_LIMIT=500
