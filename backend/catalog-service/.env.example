KOHA_BASE_URL=http://YOUR_KOHA_HOST:8081
KOHA_API_USER=YOUR_KOHA_API_USERNAME
KOHA_API_PASSWORD=YOUR_KOHA_API_PASSWORD
# Optional Koha upload endpoint. Defaults to Koha's staff upload CGI.
KOHA_UPLOAD_URL=
# Must match an authorized value in Koha's UPLOAD category.
KOHA_UPLOAD_CATEGORY=koha_kohadev_upload
# Optional reusable staff session overrides. Leave blank: the service logs in with KOHA_API_USER/PASSWORD.
# Do not commit these values; they expire and must be rotated.
KOHA_UPLOAD_COOKIE=
KOHA_UPLOAD_CSRF_TOKEN=
# Optional staff-interface credentials for the built-in upload CGI.
# Use these when KOHA_API_PASSWORD is an API key rather than the staff user's password.
KOHA_UPLOAD_USER=
KOHA_UPLOAD_PASSWORD=
PORT=3001
CORS_ORIGINS=http://localhost:5173
KOHA_TIMEOUT_MS=5000
NODE_ENV=development

# Vercel only: set LIRA_USE_TAILSCALE=1 and provide a reusable, ephemeral auth key.
# KOHA_BASE_URL must use the VM's Tailscale IPv4 address on port 8081.
# Set CORS_ORIGINS to the deployed frontend origin and store secrets in Vercel.
LIRA_USE_TAILSCALE=0
TS_AUTHKEY=

# Attachments use OPAC, separately from the staff/API port. If omitted, LIRA
# derives the same scheme/host as KOHA_BASE_URL with port 8080.
KOHA_OPAC_BASE_URL=http://YOUR_KOHA_HOST:8080
# Total content retrieval deadline, including redirects and Tailscale readiness.
EBOOK_TIMEOUT_MS=60000
# Streaming transfer limit, allowed up to 512000000 bytes; no whole-file buffer.
EBOOK_MAX_BYTES=64000000
# The existing HTML/text JSON reader remains separately bounded in memory.
EBOOK_READER_MAX_BYTES=4000000
# Optional comma-separated external origins. Omit for the Gutenberg defaults.
# Setting this replaces the defaults; an empty value disables external retrieval.
# EBOOK_ALLOWED_ORIGINS=https://www.gutenberg.org,http://www.gutenberg.org,https://gutenberg.org,http://gutenberg.org

# Optional: OpenRouter generates embeddings; Supabase holds the pgvector index.
# Leave all four credentials empty to disable paid embedding calls.
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SEMANTIC_INDEX_API_KEY=
SEMANTIC_MATCH_LIMIT=500
