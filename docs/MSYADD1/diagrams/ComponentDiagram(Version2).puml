@startuml LIRA_Component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title Component Diagram for AI Processing Service (LIRA)

Container(api, "API Gateway", "API Framework", "Routes incoming traffic to the appropriate processing component.")
System_Ext(ai, "AI Backend", "LLM Services")
ContainerDb(db, "LIRA Database", "Database", "Stores instructions, logs, and caching data.")

Container_Boundary(ai_service, "AI Processing Service") {
    Component(chatbot, "Chatbot Synchronizer & Manager", "Controller", "Processes incoming user chat queries, maintains conversational context, and synchronizes updated admin instructions.")
    Component(summary, "E-Book Summary Engine", "Controller", "Extracts resource text and interfaces with the LLM to generate concise qualitative summaries.")
    Component(citation, "Citation Generator", "Controller", "Retrieves metadata and instructs the LLM to format output into APA, MLA, etc.")
    Component(recommender, "Recommendation Engine", "Controller", "Analyzes user search intent to generate personalized material suggestions.")
    Component(faq_report, "FAQ & Report Synthesizer", "Controller", "Parses uploaded operational policies or usage data to draft FAQs and qualitative reports.")
}

Rel(api, chatbot, "Forwards chat prompts & system config updates")
Rel(api, summary, "Requests summaries for catalog items")
Rel(api, citation, "Requests citation formats")
Rel(api, recommender, "Forwards search queries for context analysis")
Rel(api, faq_report, "Sends bulk data/documents for synthesis")

Rel(chatbot, ai, "Streams conversation prompts")
Rel(summary, ai, "Sends content for summarization")
Rel(citation, ai, "Sends metadata for formatting")
Rel(recommender, ai, "Sends search context for suggestions")
Rel(faq_report, ai, "Sends documents for Q&A and report drafting")

Rel(chatbot, db, "Logs chat history and fetches system instructions")
Rel(faq_report, db, "Fetches system logging data for reports")
@enduml