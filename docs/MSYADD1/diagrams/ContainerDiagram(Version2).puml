@startuml LIRA_Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram for LIRA System

Person(student, "Student / Faculty", "Library patron")
Person(librarian, "Librarian", "Administrator")

System_Ext(koha, "Koha API", "Library System")
System_Ext(ai, "AI Backend", "LLM Services")

System_Boundary(lira, "LIRA System") {
    Container(web, "Web Portal / UI", "Web Framework (e.g., React/Vue)", "Provides the interface for searches, catalog management, and the AI chat widget.")
    Container(api, "API Gateway", "API Framework (e.g., Node.js/Spring)", "Routes requests, handles authentication, and orchestrates traffic.")
    Container(ai_service, "AI Processing Service", "Microservice (e.g., Python)", "Handles complex logic for context parsing, prompt formatting, and AI integrations.")
    Container(koha_service, "Koha Integration Service", "Microservice", "Translates LIRA requests into Koha-compatible API calls.")
    ContainerDb(db, "LIRA Database", "Relational / NoSQL", "Stores user logs, generated metadata, chatbot instructions, and reporting data.")
}

Rel(student, web, "Interacts with", "HTTPS")
Rel(librarian, web, "Administers via", "HTTPS")
Rel(web, api, "Sends API requests", "JSON/HTTPS")
Rel(api, ai_service, "Routes AI generation requests", "REST/gRPC")
Rel(api, koha_service, "Routes catalog and loan queries", "REST")
Rel(api, db, "Reads from and writes to", "SQL/NoSQL")
Rel(ai_service, ai, "Sends prompts and retrieves generated text", "HTTPS")
Rel(koha_service, koha, "Syncs catalog and borrower records", "REST API")
@enduml