@startuml C4_System_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context Diagram for APC Library Intelligent Research Assistant (LIRA)

Person(student, "Student / Faculty", "Library patron accessing the portal for resource discovery, e-book reading, citations, and AI support.")
Person(librarian, "Library Staff", "Maintains the FAQ knowledge base, curates library policies, and manages catalog.")

System(lira, "LIRA System", "An AI-assisted web platform that simplifies academic resource discovery, automates citation formatting, and provides intelligent support.")

System_Ext(koha, "Koha ILS", "External data repository acting as a read-only source for syncing physical catalog data.")
System_Ext(gutenberg, "Project Gutenberg", "External public domain e-book repository providing full text and metadata for sample academic reading.")
System_Ext(openrouter, "OpenRouter API", "Unified platform providing access to multiple AI models (e.g., GPT, Claude, Gemini) for text generation.")
System_Ext(ms365, "Microsoft 365", "External identity provider managing secure student login via existing APC institutional accounts.")

Rel(student, lira, "Uses for catalog discovery, e-book summaries, citations, and chatbot inquiries")
Rel(librarian, lira, "Maintains FAQ knowledge base via CMS and manages catalog records")
Rel(lira, koha, "Retrieves institutional catalog metadata in read-only capacity")
Rel(lira, gutenberg, "Fetches public-domain e-book texts, chapters, and metadata")
Rel(lira, openrouter, "Sends prompts and retrieves generated summaries, citations, and responses")
Rel(lira, ms365, "Authenticates users via Azure Active Directory")
@enduml