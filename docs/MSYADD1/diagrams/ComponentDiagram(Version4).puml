@startuml LIRA_Component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' Layout modifiers for clean, expanded routing
LAYOUT_TOP_DOWN()
skinparam linetype ortho
skinparam nodesep 120
skinparam ranksep 140

title Component Diagram for AI Processing Service (LIRA)

Container(api, "API Gateway", "API Framework", "Routes incoming traffic to the appropriate processing component.")

Container_Boundary(ai_service, "AI Processing Service") {
    Component(router, "Main AI Controller", "Router / Delegate", "Central controller that receives requests from the API Gateway and securely delegates them to the specific internal AI engines.")
    
    Component(faq_report, "FAQ & Report Synthesizer", "Controller", "Parses uploaded operational policies or usage data to draft FAQs and qualitative reports.")
    Component(chatbot, "Chatbot Synchronizer & Manager", "Controller", "Processes incoming user chat queries, maintains conversational context, and synchronizes updated admin instructions.")
    
    Component(summary, "E-Book Summary Engine", "Controller", "Extracts resource text and interfaces with the LLM to generate concise qualitative summaries.")
    Component(citation, "Citation Generator", "Controller", "Retrieves metadata and instructs the LLM to format output into APA, MLA, etc.")
    Component(recommender, "Recommendation Engine", "Controller", "Analyzes user search intent to generate personalized material suggestions.")
    
    Component(sync_worker, "Catalog Ingestion Engine", "Background Worker", "Scheduled process that periodically fetches catalog updates from the external library system and synchronizes them into the internal database.")
}

ContainerDb(db, "Vector Database", "ChromaDB / Weaviate", "Stores indexed representations of catalog records and FAQ content.")
System_Ext(ai, "OpenRouter API (AI LLM Service)", "AI Services")
System_Ext(koha, "Koha ILS", "External Library System")

' 1. API to Router
Rel_Down(api, router, "Forwards all processing and\ngeneration requests", "REST/JSON")

' 2. Router to Internal Components
Rel_Down(router, faq_report, "Delegates document\nsynthesis tasks", "Internal Method Call")
Rel_Down(router, chatbot, "Delegates conversational\nqueries", "Internal Method Call")
Rel_Down(router, summary, "Delegates summarization\nrequests", "Internal Method Call")
Rel_Down(router, citation, "Delegates formatting\nrequests", "Internal Method Call")
Rel_Down(router, recommender, "Delegates recommendation\nrequests", "Internal Method Call")

' 3. Components to External AI
Rel_Down(faq_report, ai, "Sends documents for Q&A\nand report drafting", "HTTPS")
Rel_Down(chatbot, ai, "Streams conversation\nprompts", "HTTPS")
Rel_Down(summary, ai, "Sends content for\nsummarization", "HTTPS")
Rel_Down(citation, ai, "Sends metadata for\nformatting", "HTTPS")
Rel_Down(recommender, ai, "Sends search context\nfor suggestions", "HTTPS")

' 4. Components to Internal Vector Database
Rel_Down(faq_report, db, "Stores and fetches indexed\nFAQ policy content", "Vector Search API")
Rel_Down(chatbot, db, "Retrieves indexed library\nknowledge for context matching", "Vector Search API")
Rel_Down(summary, db, "Fetches indexed catalog\ntext for summaries", "Vector Search API")
Rel_Down(citation, db, "Retrieves indexed catalog\nmetadata for formatting", "Vector Search API")
Rel_Down(recommender, db, "Queries indexed catalog data\nfor semantic suggestions", "Vector Search API")

' 5. Data Ingestion Flow (Decoupled Background Task)
Rel_Down(sync_worker, koha, "Fetches catalog metadata updates\nin read-only capacity", "REST API")
Rel_Down(sync_worker, db, "Writes and indexes synchronized\ncatalog records", "Vector Search API")

@enduml