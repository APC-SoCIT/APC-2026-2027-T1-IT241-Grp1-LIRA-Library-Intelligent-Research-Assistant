@startuml LIRA_Container_Diagram
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container Diagram for LIRA System (Scoped to AI Features)

' Tags to distinguish existing infrastructure from new AI additions
AddElementTag("existing", $bgColor="#1B5DA6", $fontColor="#FFFFFF", $borderColor="#0C447C")
AddElementTag("new", $bgColor="#126E60", $fontColor="#FFFFFF", $borderColor="#085041")
AddElementTag("external", $bgColor="#8C8C8C", $fontColor="#FFFFFF", $borderColor="#444441")

Person(student, "Student", "Library patron")
Person(staff, "Library Staff", "Administrator, maintains FAQ knowledge base")

System_Boundary(lira, "LIRA System") {
    Container(webportal, "Web Portal / UI", "Next.js", "EXISTING - student portal & OPAC, extended with new AI chat widget and citation panel", $tags="existing")
    Container(apigw, "API Gateway", "API Framework", "EXISTING - extended to route new AI requests", $tags="existing")
    Container(aiproc, "AI Processing Service", "Microservice", "NEW - handles AI generation, prompt formatting, and orchestration", $tags="new")
    ContainerDb(vectordb, "Vector Database", "ChromaDB / Weaviate", "NEW - stores indexed catalog and FAQ content for semantic search", $tags="new")
}

System_Ext(koha, "Koha ILS", "Library system, read-only source for catalog data", $tags="external")
System_Ext(openrouter, "OpenRouter API", "NEW integration - AI/LLM generation service", $tags="external")
System_Ext(ms365, "Microsoft 365", "EXISTING SSO - authentication provider", $tags="external")

Rel(student, webportal, "Interacts with", "HTTPS")
Rel(staff, webportal, "Administers via existing CMS view", "HTTPS")

Rel(webportal, apigw, "Sends API requests", "JSON/HTTPS")
Rel(apigw, aiproc, "Routes AI requests", "REST/gRPC")
Rel(aiproc, vectordb, "Reads/writes", "Vector Search API")

Rel(aiproc, koha, "Syncs catalog data, read-only", "REST")
Rel(aiproc, openrouter, "Sends prompts, retrieves text", "HTTPS")
Rel(webportal, ms365, "Authenticates via Azure AD", "OAuth/HTTPS")

SHOW_LEGEND()

@enduml
